PORT=4000
DATABASE_URL="postgresql://welltrack:welltrack@localhost:5432/welltrack?schema=public"
FRONTEND_URL="http://localhost:5173"
# Real secrets — generate your own (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# and never commit real values here. Access and refresh tokens use separate secrets so a
# leaked access-token secret alone can't be used to mint new refresh tokens, or vice versa.
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
# Generate a real pair with `npx web-push generate-vapid-keys`. Required only for the reminders
# feature (GET /api/push/vapid-public-key and sending real push notifications) - every other
# route works fine without these set.
VAPID_PUBLIC_KEY="replace-with-a-generated-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-a-generated-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"
# The single hardcoded admin account (see lib/isAdmin.ts) - whichever email registers with this
# exact address (case-insensitive) gets access to /api/admin/categories. Not a DB role/permission
# system: there's exactly one admin and no plan for more. Unset means no account is ever treated
# as admin.
ADMIN_EMAIL="you@example.com"
