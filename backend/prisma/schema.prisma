// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now()) @map("created_at")

  // Populated only while a forgot-password reset is pending; both null the rest of the time.
  // Only the SHA-256 hash of the raw reset token is stored - never the raw token itself - the
  // same "never store the raw secret" principle as passwordHash, applied to a different kind of
  // secret. See backend/src/routes/auth.ts's forgot-password/reset-password handlers for how
  // these are set, checked, and cleared (a reset token is single-use and time-limited).
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")

  // habitEnabled (Phase 16), symptomEnabled and moodEnabled (both Phase 17), and medicationEnabled
  // (Phase 19) were all removed once Habit/Symptom/Mood/Medication unified into Category - a
  // former habit or medication is an ordinary personal category (individually archivable, no
  // whole-type toggle needed); a former symptom or Mood/Energy/Stress is a system category a user
  // hides per-row via HiddenCategory instead of one blunt toggle for all of them. See
  // docs/log/17-unify-mood-symptom-habit.md and docs/log/19-medication-to-category.md.

  pushSubscriptions PushSubscription[]
  categories        Category[]
  categoryGroups    CategoryGroup[]
  categoryLogs      CategoryLog[]
  reminders         Reminder[]
  hiddenCategories  HiddenCategory[]
  hiddenGroups      HiddenGroup[]

  @@map("users")
}

// One row per browser/device a user has enabled push reminders on - a user can have several
// (phone, laptop, etc.), each with its own endpoint the browser's push service delivers to.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every reminder-send pass queries "all subscriptions for this user."
  @@index([userId])
  @@map("push_subscriptions")
}

// A category's `valueType` decides which single column on CategoryLog is expected to be
// populated - BOOLEAN/NUMERIC/DURATION (the same three the now-retired Habit and Medication models
// used to have, before they unified into Category - see docs/log/17-unify-mood-symptom-habit.md
// and docs/log/19-medication-to-category.md), plus SCALE: a bounded 1-N picker (see
// Category.scaleMin/scaleMax) generalizing what the now-retired Symptom model used to do with its
// own fixed 1-10 severity scale, and what Mood/Energy/Stress now do too, since all of them unified
// into Category. Every built-in scale category (Mood, Energy, Stress, and the 8 seeded severity
// categories) was standardized onto a common 1-7 range - see docs/log/21-unify-scale-to-seven.md -
// though a user's own custom scale category may still use any range they choose. SCALE shares
// NUMERIC's storage column (valueNumeric) - the two differ only in whether a min/max bound is
// enforced at write time, not in how the value itself is stored.
enum CategoryValueType {
  BOOLEAN
  NUMERIC
  SCALE
  DURATION

  @@map("category_value_type")
}

// An organizational bucket a Category can optionally belong to (see Category.groupId below) -
// purely a display/navigation grouping, with no logged history of its own the way a Category has
// (a CategoryLog always points at a Category, never directly at a Group), which is what makes
// this a much lower-stakes model than Category: hiding one (see HiddenGroup) can never lose data,
// since the categories inside it are completely unaffected and still reachable on their own.
// `userId` follows the identical nullable convention Category itself already uses: null = a
// built-in group visible to everyone (seeded directly - there's no admin-route equivalent yet,
// unlike Category's own admin-managed system rows), set = a user's own custom group, visible only
// to them. See docs/log/23-category-groups.md.
model CategoryGroup {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  name      String
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")

  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories Category[]
  hiddenBy   HiddenGroup[]

  @@index([userId])
  @@map("category_groups")
}

// A per-user "don't show me this group" preference - deliberately available for a built-in group
// *and* a user's own custom one alike, unlike HiddenCategory below (which only ever applies to a
// system category, since a personal category already has Delete for that). A group can't be
// deleted yet (see docs/log/23-category-groups.md - reordering/drag-and-drop and group deletion
// are both explicitly deferred follow-on work), so hiding is currently the *only* way to get a
// regretted custom group out of view, which is exactly why it isn't restricted to built-in groups
// the way category hiding is.
model HiddenGroup {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  groupId   String   @map("group_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group CategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("hidden_groups")
}

// A user-extensible trackable category - every loggable thing in this app is one of these now
// that Habit, Symptom, Mood, and Medication have all unified into it (see
// docs/log/17-unify-mood-symptom-habit.md and docs/log/19-medication-to-category.md). `userId`
// follows the exact same nullable convention Symptom originally established: null = a system-wide
// category (created only via the admin-only routes, visible to every user), set = a user's own
// personal category, visible only to them.
model Category {
  id          String            @id @default(uuid())
  userId      String?           @map("user_id")
  name        String
  icon        String?
  // Optional freeform text about what this category is for - gives a home to context a category's
  // own name doesn't capture on its own (e.g. what "Joint pain" specifically refers to for this
  // user, or a former Medication's own dosage, e.g. "200mg" - see docs/log/19-medication-to-
  // category.md).
  description String?
  valueType   CategoryValueType @map("value_type")
  // Only meaningful when valueType is SCALE - enforced in application code (see
  // routes/categories.ts and categoryLogs.ts) rather than a DB CHECK constraint.
  scaleMin    Int?              @map("scale_min")
  scaleMax    Int?              @map("scale_max")
  // Soft-removal, not a real (hard) delete - a system category used by even one user would
  // otherwise become permanently undeletable the moment CategoryLog's Restrict relation (below)
  // kicks in. Excluded from default listings; a log against an archived category still resolves
  // it by id in History, exactly like any other now-hidden reference. For a system category
  // (userId null), this is an admin-only, permanent "retire this built-in" action with no expiry.
  // For a personal category (userId set), DELETE /api/categories/:id sets this as the start of a
  // 30-day undo window - see categoryPurgeScheduler.ts, the background job that actually removes
  // it for real once that window passes, but only if it still has zero logs by then; one with
  // real logged history is kept indefinitely rather than ever being silently erased. See
  // docs/log/22-category-soft-delete-with-undo.md for the full reasoning.
  archivedAt  DateTime?         @map("archived_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  // Optional - a category with no group shows under a synthetic "Uncategorized" bucket in the UI
  // (not a real CategoryGroup row), rather than forcing every existing or newly-created category
  // to pick a group up front. SetNull rather than Restrict: a category's group membership is
  // organizational metadata, not something that should ever block or cascade a real change to the
  // group itself - if a group a category belongs to is ever removed, the category should simply
  // fall back to Uncategorized, never disappear or block the group's own removal.
  groupId String? @map("group_id")

  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     CategoryGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  logs      CategoryLog[]
  reminders Reminder[]
  hiddenBy  HiddenCategory[]

  // Every "list my categories" query (GET /api/categories) filters on userId (including the
  // NULL case for system categories), so this index keeps that lookup fast as the category
  // list grows across many users.
  @@index([userId])
  // Supports "every category in this group" lookups (rendering one group's own section).
  @@index([groupId])
  @@map("categories")
}

// A per-user "don't show me this system category" preference - the tool for a category a user
// didn't create and can't archive themselves (a system-wide category, userId null). A user's own
// personal category has no need for this at all: archiving (Category.archivedAt above) already
// does the job, since they own it. Unlike CategoryLog, this has no historical value of its own -
// deleting the user or the category itself should just make the preference disappear along with
// it, so both FKs cascade.
model HiddenCategory {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // A user can only hide a given category once - re-hiding an already-hidden one is a harmless
  // no-op at the application layer (see routes/categories.ts), not a distinct row.
  @@unique([userId, categoryId])
  @@map("hidden_categories")
}

model CategoryLog {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  categoryId String @map("category_id")

  // Exactly one of these three is populated, matching the parent Category's `valueType` -
  // enforced in application code (see routes/categoryLogs.ts). The same shape and column names
  // the now-retired HabitLog model used to have (see docs/log/17-unify-mood-symptom-habit.md) -
  // its own rows were migrated directly into this table for exactly that reason.
  valueBoolean         Boolean? @map("value_boolean")
  valueNumeric         Float?   @map("value_numeric")
  valueDurationMinutes Int?     @map("value_duration_minutes")

  notes    String?
  loggedAt DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // No onDelete: Cascade from Category - deleting a category (rather than archiving it) shouldn't
  // silently destroy a user's historical logs against it. Restrict (Prisma's default for a
  // relation with no onDelete specified) is the safety net for the genuine zero-logs
  // accidental-delete case;
  // Category.archivedAt above is the actual day-to-day "remove" action, for both personal and
  // system categories.
  category Category @relation(fields: [categoryId], references: [id])

  // Same reasoning every log table in this schema shares: every dashboard/history/trends query
  // filters by user and orders/ranges by date together.
  @@index([userId, loggedAt])
  // Supports "this category's log history" lookups (e.g. a per-category detail/trend view).
  @@index([categoryId, loggedAt])
  @@map("category_logs")
}

// What a Reminder is "about." GENERAL is the original whole-app "you haven't logged anything
// today" nudge; CATEGORY is always paired with a specific Category row (see Reminder.categoryId
// below) - a user can have one reminder for "Diazepam" and a completely independent one for
// "Sertraline," each its own Category now, which a whole-type-level target couldn't express.
//
// HABIT and SYMPTOM (both Phase 17) were removed once Habit/Symptom unified into Category - any
// existing HABIT- or SYMPTOM-target reminder was deleted by its own migration (confirmed directly
// both times: drop and let the user reconfigure, rather than attempt a lossy auto-remap to one
// specific former habit/symptom). MOOD (Phase 17) and MEDICATION (Phase 19) were each removed the
// same way, but are the two deliberate exceptions to drop-and-reconfigure: MOOD had always at most
// one reminder per user with exactly one unambiguous destination (the new system Mood category);
// MEDICATION had a clean one-to-one mapping (each medication became exactly one category, reusing
// its own id) - both migrations remapped any existing reminder to a CATEGORY-target reminder
// pointing at the right category instead of deleting it. See docs/log/17-unify-mood-symptom-
// habit.md and docs/log/19-medication-to-category.md. A former habit's, symptom's, mood's, or
// medication's reminder is now just a CATEGORY-target reminder like any other category's.
enum ReminderTarget {
  GENERAL
  CATEGORY

  @@map("reminder_target")
}

// Replaces the single reminderEnabled/reminderTime pair User used to carry directly - a user can
// now have any number of these, each aimed at a different target. `categoryId` is only ever set
// alongside target CATEGORY - enforced in application code (see routes/reminders.ts), the same
// choice this schema already makes for CategoryLog's own type-conditional value columns rather
// than a DB CHECK constraint.
model Reminder {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  target     ReminderTarget
  categoryId String?        @map("category_id")
  // One or more "HH:mm" 24-hour local times - a plain Postgres text array rather than a separate
  // join table, since nothing beyond this Reminder's own row ever needs to reference a single
  // time in isolation (ReminderSend below references a time by its string value directly, not by
  // a foreign key to a row here). Multiple entries are what let "every 3 hours" be approximated
  // as several fixed times (e.g. ["09:00","12:00","15:00"]) without any real recurring-interval
  // logic - confirmed directly with the user that fixed times are the whole point, not true
  // intervals.
  times      String[]
  enabled    Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade - and not left as the bare default either: for an *optional* scalar
  // relation like this one (categoryId is nullable), Prisma's actual unspecified-onDelete default
  // is SetNull, not Restrict (Restrict is only the implicit default for a *required* relation,
  // which is why CategoryLog.category - categoryId is non-nullable there - gets it "for free").
  // SetNull would silently leave a CATEGORY-target reminder pointing at no category at all if a
  // hard delete ever did happen - nonsensical, since a CATEGORY reminder's whole meaning comes
  // from the category it names. Restrict is stated explicitly here instead, so a hard delete is
  // blocked at the database level rather than corrupting the row. In practice this almost never
  // fires either way: Category is never hard-deleted (categories.ts's own DELETE route only sets
  // archivedAt), and archiving a category explicitly sets enabled: false on every Reminder
  // targeting it (see categories.ts/adminCategories.ts) - "stop acting on it" rather than relying
  // on a delete path that doesn't really happen.
  category Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sends    ReminderSend[]

  // Every "list my reminders" query (GET /api/reminders) filters by user; the scheduler's own
  // tick queries "every enabled reminder" across all users, so no separate userId-only index is
  // needed there.
  @@index([userId])
  @@map("reminders")
}

// One row per (reminder, calendar day, specific time) that has actually fired - what replaces
// User.lastReminderSentDate's single-date gate. A single Reminder can have several independent
// times in one day (e.g. "09:00" and "15:00"), each needing its own once-per-day gate, which one
// shared per-user date string could no longer express once reminders stopped being one-per-user.
model ReminderSend {
  id         String   @id @default(uuid())
  reminderId String   @map("reminder_id")
  date       String
  time       String
  sentAt     DateTime @default(now()) @map("sent_at")

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  // An idempotency guard (has this exact slot already fired today), not a business-rule
  // constraint - the same distinction PushSubscription.endpoint's own @unique already draws in
  // this schema.
  @@unique([reminderId, date, time])
  // The scheduler's own tick fetches "every send today for these candidate reminder ids" in one
  // batched query (see reminderScheduler.ts) rather than one query per (reminder, time) pair.
  @@index([reminderId, date])
  @@map("reminder_sends")
}
