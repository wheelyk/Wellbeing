// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now()) @map("created_at")

  // Populated only while a forgot-password reset is pending; both null the rest of the time.
  // Only the SHA-256 hash of the raw reset token is stored - never the raw token itself - the
  // same "never store the raw secret" principle as passwordHash, applied to a different kind of
  // secret. See backend/src/routes/auth.ts's forgot-password/reset-password handlers for how
  // these are set, checked, and cleared (a reset token is single-use and time-limited).
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")

  // Lets a user hide a built-in category (Mood/Symptom/Medication) from Dashboard/Quick Add
  // without touching any data already logged under it - the toggle-off direction explored
  // alongside the custom-Category feature and shipped here as a follow-up. All default true so
  // every existing account keeps today's behavior unchanged. Turning one off also disables (not
  // deletes) any Reminder targeting that category - see routes/users.ts's PATCH /me.
  //
  // habitEnabled (Phase 16) was removed when Habit unified into Category (Phase 17) - a former
  // habit is now an ordinary personal category, individually archivable like any other, so no
  // whole-type toggle is needed for it anymore. See docs/log/17-unify-mood-symptom-habit.md.
  moodEnabled       Boolean @default(true) @map("mood_enabled")
  symptomEnabled    Boolean @default(true) @map("symptom_enabled")
  medicationEnabled Boolean @default(true) @map("medication_enabled")

  moodLogs          MoodLog[]
  medications       Medication[]
  medicationLogs    MedicationLog[]
  symptoms          Symptom[]
  symptomLogs       SymptomLog[]
  pushSubscriptions PushSubscription[]
  categories        Category[]
  categoryLogs      CategoryLog[]
  reminders         Reminder[]
  hiddenCategories  HiddenCategory[]

  @@map("users")
}

// One row per browser/device a user has enabled push reminders on - a user can have several
// (phone, laptop, etc.), each with its own endpoint the browser's push service delivers to.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every reminder-send pass queries "all subscriptions for this user."
  @@index([userId])
  @@map("push_subscriptions")
}

model MoodLog {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  mood     Int
  energy   Int?
  stress   Int?
  notes    String?
  loggedAt DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every dashboard/history/trends query in later phases filters by user and orders/ranges
  // by date, so this composite index is what keeps those queries fast as log counts grow.
  @@index([userId, loggedAt])
  @@map("mood_logs")
}

// A user's own list of medications they take (e.g. "Ibuprofen", "Vitamin D"), with an optional
// dosage (e.g. "200mg") - beyond requirements §6.3's original MVP scope of name-only, added so
// "Diazepam 2mg" doesn't have to be crammed into the name field itself. Each MedicationLog below
// points back at one of these to record whether it was taken on a given occasion; each Reminder
// below can point at one of these too, for a reminder specific to this one medication (e.g.
// "Diazepam at 10:00") rather than the Medication category as a whole.
model Medication {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  dosage    String?
  createdAt DateTime @default(now()) @map("created_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      MedicationLog[]
  reminders Reminder[]

  // Every "list my medications" query filters by user; logs additionally query by medication,
  // so this index covers the "does this user own this medication" ownership check used before
  // any medication-log write (the ID-tampering defense described on MedicationLog below).
  @@index([userId])
  @@map("medications")
}

model MedicationLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  medicationId String   @map("medication_id")
  taken        Boolean
  notes        String?
  loggedAt     DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  // Denormalized userId (in addition to the medicationId relation) rather than joining through
  // Medication for every read - the same shape MoodLog uses, and it's what lets a "list my
  // medication logs" query filter directly on this table instead of joining out to Medication
  // first. The application layer still independently verifies medicationId belongs to userId
  // before every write (see routes/medicationLogs.ts) - this column is not, on its own, a
  // substitute for that check, since nothing here stops userId and the medication's own owner
  // from disagreeing unless the application enforces it.
  @@index([userId, loggedAt])
  @@index([medicationId])
  @@map("medication_logs")
}

// A symptom a user can log against. `userId` is nullable specifically to represent two
// different kinds of row in the same table: a system-default symptom (e.g. "Headache",
// seeded once, available to every user, `userId` null) versus a user's own custom symptom
// (e.g. "Joint pain," `userId` set to whoever created it). Every symptom-log write must
// verify the symptom it references is one of these two cases for the calling user -
// enforced in the symptom-logs routes, not here at the schema level.
model Symptom {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // onDelete: Cascade here means deleting a user also deletes any custom symptoms they
  // created - consistent with the account-deletion requirement (Phase 2) that removing a
  // user removes everything they own. System symptoms (userId null) have no user row to
  // cascade from, so they're unaffected by any user's deletion.
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  symptomLogs SymptomLog[]

  // Every "list my symptoms" query (GET /api/symptoms) filters on userId (including the
  // NULL case for system symptoms), so this index keeps that lookup fast as the symptom
  // list grows across many users.
  @@index([userId])
  @@map("symptoms")
}

model SymptomLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  symptomId String   @map("symptom_id")
  severity  Int
  notes     String?
  loggedAt  DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // No onDelete: Cascade from Symptom - a symptom (especially a user's own custom one)
  // being deleted shouldn't silently destroy the user's historical severity logs against
  // it. Restrict is Prisma's default for a relation with no onDelete specified, and it's
  // the right choice here: deleting a symptom that still has logs against it fails at the
  // database level rather than either cascading (losing history) or leaving orphaned rows.
  symptom Symptom @relation(fields: [symptomId], references: [id])

  // Same reasoning as MoodLog's composite index: every dashboard/history/trends query
  // filters by user and orders/ranges by date together.
  @@index([userId, loggedAt])
  @@map("symptom_logs")
}

// A category's `valueType` decides which single column on CategoryLog is expected to be
// populated - BOOLEAN/NUMERIC/DURATION (the same three the now-retired Habit model used to have,
// before it unified into Category - see docs/log/17-unify-mood-symptom-habit.md), plus SCALE: a
// bounded 1-N picker (see Category.scaleMin/scaleMax) generalizing what Mood/Symptom still do
// with their own fixed scales, as of this writing. SCALE shares NUMERIC's storage column
// (valueNumeric) - the two differ only in whether a min/max bound is enforced at write time, not
// in how the value itself is stored.
enum CategoryValueType {
  BOOLEAN
  NUMERIC
  SCALE
  DURATION

  @@map("category_value_type")
}

// A user-extensible trackable category, alongside (not replacing) the four fixed built-in
// categories above. `userId` follows the exact same nullable convention Symptom already
// established: null = a system-wide category (created only via the admin-only routes, visible
// to every user), set = a user's own personal category, visible only to them.
model Category {
  id          String            @id @default(uuid())
  userId      String?           @map("user_id")
  name        String
  icon        String?
  // Optional freeform text about what this category is for - not used by any built-in category
  // yet, but gives a home to context a category's own name doesn't capture on its own (e.g. what
  // "Joint pain" specifically refers to for this user).
  description String?
  valueType   CategoryValueType @map("value_type")
  // Only meaningful when valueType is SCALE - enforced in application code (see
  // routes/categories.ts and categoryLogs.ts), the same choice Symptom already makes for its own
  // type-conditional fields rather than a DB CHECK constraint.
  scaleMin    Int?              @map("scale_min")
  scaleMax    Int?              @map("scale_max")
  // Archiving (not deleting) is this model's primary "remove" action - a system category used by
  // even one user would otherwise become permanently undeletable the moment CategoryLog's
  // Restrict relation (below) kicks in, which is fine for a personal mistake but not for an admin
  // wanting to retire a bad built-in. Excluded from default listings; a log against an archived
  // category still resolves it by id in History, exactly like any other now-hidden reference.
  archivedAt  DateTime?         @map("archived_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      CategoryLog[]
  reminders Reminder[]
  hiddenBy  HiddenCategory[]

  // Every "list my categories" query (GET /api/categories) filters on userId (including the
  // NULL case for system categories), the same reasoning as Symptom's own index.
  @@index([userId])
  @@map("categories")
}

// A per-user "don't show me this system category" preference - the tool for a category a user
// didn't create and can't archive themselves (a system-wide category, userId null). A user's own
// personal category has no need for this at all: archiving (Category.archivedAt above) already
// does the job, since they own it. Unlike CategoryLog, this has no historical value of its own -
// deleting the user or the category itself should just make the preference disappear along with
// it, so both FKs cascade.
model HiddenCategory {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // A user can only hide a given category once - re-hiding an already-hidden one is a harmless
  // no-op at the application layer (see routes/categories.ts), not a distinct row.
  @@unique([userId, categoryId])
  @@map("hidden_categories")
}

model CategoryLog {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  categoryId String @map("category_id")

  // Exactly one of these three is populated, matching the parent Category's `valueType` -
  // enforced in application code (see routes/categoryLogs.ts). The same shape and column names
  // the now-retired HabitLog model used to have (see docs/log/17-unify-mood-symptom-habit.md) -
  // its own rows were migrated directly into this table for exactly that reason.
  valueBoolean         Boolean? @map("value_boolean")
  valueNumeric         Float?   @map("value_numeric")
  valueDurationMinutes Int?     @map("value_duration_minutes")

  notes    String?
  loggedAt DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // No onDelete: Cascade from Category - same reasoning as SymptomLog -> Symptom: deleting a
  // category (rather than archiving it) shouldn't silently destroy a user's historical logs
  // against it. Restrict is the safety net for the genuine zero-logs accidental-delete case;
  // Category.archivedAt above is the actual day-to-day "remove" action, for both personal and
  // system categories.
  category Category @relation(fields: [categoryId], references: [id])

  // Same reasoning as MoodLog's composite index: every dashboard/history/trends query filters by
  // user and orders/ranges by date together.
  @@index([userId, loggedAt])
  // Supports "this category's log history" lookups (e.g. a per-category detail/trend view).
  @@index([categoryId, loggedAt])
  @@map("category_logs")
}

// What a Reminder is "about." GENERAL is the original whole-app "you haven't logged anything
// today" nudge; MOOD/SYMPTOM are category-level (no per-instance granularity - there's only ever
// at most one reminder per user for each of these); MEDICATION and CATEGORY are always paired
// with a specific Medication/Category row (see Reminder.medicationId/categoryId below) - a user
// can have one reminder for "Diazepam" and a completely independent one for "Sertraline," which a
// category-level MEDICATION reminder couldn't express.
//
// HABIT (Phase 16) was removed when Habit unified into Category (Phase 17) - any existing
// HABIT-target reminder was deleted by that migration (confirmed directly: drop and let the user
// reconfigure, rather than attempt a lossy auto-remap to one specific former habit). A former
// habit's own reminder is now just a CATEGORY-target reminder like any other category's.
enum ReminderTarget {
  GENERAL
  MOOD
  SYMPTOM
  MEDICATION
  CATEGORY

  @@map("reminder_target")
}

// Replaces the single reminderEnabled/reminderTime pair User used to carry directly - a user can
// now have any number of these, each aimed at a different target. `medicationId`/`categoryId`
// are mutually exclusive with each other and only ever set together with the matching `target`
// (MEDICATION -> medicationId, CATEGORY -> categoryId) - enforced in application code (see
// routes/reminders.ts), the same choice this schema already makes for CategoryLog's own
// type-conditional value columns rather than a DB CHECK constraint.
model Reminder {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  target       ReminderTarget
  medicationId String?        @map("medication_id")
  categoryId   String?        @map("category_id")
  // One or more "HH:mm" 24-hour local times - a plain Postgres text array rather than a separate
  // join table, since nothing beyond this Reminder's own row ever needs to reference a single
  // time in isolation (ReminderSend below references a time by its string value directly, not by
  // a foreign key to a row here). Multiple entries are what let "every 3 hours" be approximated
  // as several fixed times (e.g. ["09:00","12:00","15:00"]) without any real recurring-interval
  // logic - confirmed directly with the user that fixed times are the whole point, not true
  // intervals.
  times        String[]
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cascade: mirrors Medication's own real hard-delete (MedicationLog also cascades from it) -
  // a reminder about a medication that no longer exists has nothing left to be about.
  medication Medication?    @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade - and not left as the bare default either: for an *optional* scalar
  // relation like this one (categoryId is nullable), Prisma's actual unspecified-onDelete default
  // is SetNull, not Restrict (Restrict is only the implicit default for a *required* relation,
  // which is why CategoryLog.category - categoryId is non-nullable there - gets it "for free").
  // SetNull would silently leave a CATEGORY-target reminder pointing at no category at all if a
  // hard delete ever did happen - nonsensical, since a CATEGORY reminder's whole meaning comes
  // from the category it names. Restrict is stated explicitly here instead, so a hard delete is
  // blocked at the database level rather than corrupting the row. In practice this almost never
  // fires either way: Category is never hard-deleted (categories.ts's own DELETE route only sets
  // archivedAt), and archiving a category explicitly sets enabled: false on every Reminder
  // targeting it (see categories.ts/adminCategories.ts) - "stop acting on it" rather than relying
  // on a delete path that doesn't really happen.
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sends      ReminderSend[]

  // Every "list my reminders" query (GET /api/reminders) filters by user; the scheduler's own
  // tick queries "every enabled reminder" across all users, so no separate userId-only index is
  // needed there.
  @@index([userId])
  @@map("reminders")
}

// One row per (reminder, calendar day, specific time) that has actually fired - what replaces
// User.lastReminderSentDate's single-date gate. A single Reminder can have several independent
// times in one day (e.g. "09:00" and "15:00"), each needing its own once-per-day gate, which one
// shared per-user date string could no longer express once reminders stopped being one-per-user.
model ReminderSend {
  id         String   @id @default(uuid())
  reminderId String   @map("reminder_id")
  date       String
  time       String
  sentAt     DateTime @default(now()) @map("sent_at")

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  // An idempotency guard (has this exact slot already fired today), not a business-rule
  // constraint - the same distinction PushSubscription.endpoint's own @unique already draws in
  // this schema.
  @@unique([reminderId, date, time])
  // The scheduler's own tick fetches "every send today for these candidate reminder ids" in one
  // batched query (see reminderScheduler.ts) rather than one query per (reminder, time) pair.
  @@index([reminderId, date])
  @@map("reminder_sends")
}
